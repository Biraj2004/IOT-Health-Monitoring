# Optional HTTP base URL for the FastAPI backend (leave empty to use the Vite /api proxy in dev/preview)
# Example: http://127.0.0.1:8000 or https://your-backend.example.com
VITE_API_BASE_URL=

# Optional WebSocket stream URL (leave empty to derive from current host /ws/health or VITE_API_BASE_URL)
# Example: ws://127.0.0.1:8000/ws/health or wss://your-backend.example.com/ws/health
VITE_WS_URL=

# Optional WebSocket authentication token matching server WS_AUTH_TOKEN
VITE_WS_TOKEN=

# Optional default device ID filter (leave empty to auto-follow active devices)
VITE_DEVICE_ID=

# Enable offline simulated baseline drift when the backend WebSocket is unavailable (true | false)
VITE_ENABLE_DEMO_FALLBACK=false
